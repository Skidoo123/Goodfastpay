# Goodfastpay — environment template. PLACEHOLDERS ONLY. Never real values.
# Copy to .env for local dev: cp .env.example .env
# Production values live in Vercel / Doppler, never in git.

# Server-only. NEVER prefix with VITE_ / NEXT_PUBLIC_.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call the API
ALLOWED_ORIGINS=https://goodfastpay.com,https://www.goodfastpay.com

# Public values only (safe to ship to the browser via /api/config)
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
